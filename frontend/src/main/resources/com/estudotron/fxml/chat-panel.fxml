<?xml version="1.0" encoding="UTF-8"?>

<?import com.estudotron.component.GlassCard?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Chat (coluna à direita): cabeçalho, histórico, aviso de erro, referências aos PDFs e campo de envio. -->
<GlassCard xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" minWidth="0" minHeight="0">
<VBox fx:id="root" styleClass="chat-panel, glass" minWidth="0" minHeight="0">
    <HBox styleClass="chat-header" alignment="CENTER_LEFT" spacing="8">
        <StackPane fx:id="chatIcon"/>
        <Label text="Assistente" styleClass="chat-title" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
        <Button fx:id="newChatButton" styleClass="icon-button" onAction="#newConversation"/>
        <ComboBox fx:id="providerBox" prefWidth="170" minWidth="110"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS" minHeight="0">
        <ScrollPane fx:id="historyScroll" styleClass="chat-scroll" fitToWidth="true" hbarPolicy="NEVER">
            <VBox fx:id="messageList" styleClass="message-list" spacing="14"/>
        </ScrollPane>
        <VBox fx:id="emptyState" alignment="CENTER" spacing="6" mouseTransparent="true" styleClass="empty-state">
            <StackPane fx:id="emptyIcon"/>
            <Label text="Converse com a IA sobre os seus PDFs" styleClass="empty-title" wrapText="true"/>
            <Label text="Ela usa os dois documentos como fonte e cita o arquivo e a página de cada informação."
                   styleClass="empty-hint" wrapText="true"/>
        </VBox>
    </StackPane>

    <!-- Erros que acontecem antes de a conversa começar (sem chave, sem PDF, PDF ainda indexando...) -->
    <HBox fx:id="errorBanner" styleClass="error-banner" alignment="CENTER_LEFT" spacing="10" visible="false"
          managed="false">
        <StackPane fx:id="errorIcon"/>
        <Label fx:id="errorText" styleClass="error-banner-text" wrapText="true" HBox.hgrow="ALWAYS" minWidth="0"/>
        <Button fx:id="errorAction" text="Configurações" styleClass="secondary" onAction="#openSettings"
                visible="false" managed="false" minWidth="-Infinity"/>
        <Button fx:id="errorClose" styleClass="icon-button" onAction="#dismissBanner" minWidth="-Infinity"/>
    </HBox>

    <VBox fx:id="referencesBar" styleClass="references-bar" spacing="6">
        <Label text="REFERÊNCIAS DA ÚLTIMA RESPOSTA" styleClass="muted-small"/>
        <FlowPane fx:id="referenceChips" hgap="6" vgap="6" minWidth="0"/>
    </VBox>

    <VBox styleClass="composer" spacing="6">
        <HBox spacing="8" alignment="BOTTOM_LEFT">
            <TextArea fx:id="input" wrapText="true" prefRowCount="3" HBox.hgrow="ALWAYS" minWidth="0"
                      promptText="Pergunte sobre os PDFs…"/>
            <Button fx:id="sendButton" styleClass="primary, send-button" onAction="#sendOrStop"/>
        </HBox>
        <Label text="Enter envia · Shift+Enter nova linha" styleClass="composer-hint"/>
    </VBox>
</VBox>
</GlassCard>
