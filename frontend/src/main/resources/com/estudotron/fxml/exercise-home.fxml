<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Tela inicial de exercícios: título, descrição, PDFs carregados (cartões flutuantes) e as duas modalidades.
     Sem PDFs, no lugar dos cartões aparece o aviso com a ação para ir ao Leitor de PDFs. -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="ex-scroll"
            fitToWidth="true" hbarPolicy="NEVER">
    <StackPane styleClass="ex-wrap" alignment="TOP_CENTER">
        <VBox styleClass="ex-home" maxWidth="980" spacing="24">
            <VBox spacing="6">
                <Label text="Criar Exercícios" styleClass="ex-title"/>
                <Label text="Pratique com questões criadas pela IA a partir dos PDFs que você carregou no Leitor de PDFs. Escolha a modalidade e responda no seu ritmo."
                       styleClass="ex-subtitle" wrapText="true" minHeight="-Infinity"/>
            </VBox>

            <VBox fx:id="sourcesBox" spacing="10">
                <Label text="DOCUMENTOS DE ORIGEM" styleClass="muted-small"/>
                <FlowPane fx:id="sourceCards" hgap="14" vgap="12" styleClass="source-row"/>
            </VBox>

            <StackPane fx:id="emptyBox" visible="false" managed="false" styleClass="ex-empty"/>

            <HBox fx:id="modeRow" spacing="20" fillHeight="true"/>

            <Label fx:id="hint" styleClass="muted-info" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </StackPane>
</ScrollPane>
