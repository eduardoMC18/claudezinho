<?xml version="1.0" encoding="UTF-8"?>

<?import com.estudotron.component.DropZone?>
<?import com.estudotron.component.GlassCard?>
<?import com.estudotron.component.PdfViewerPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Um slot de documento: cartão de vidro com cabeçalho, visualizador SÓLIDO (PDF.js) e barra de controles. -->
<GlassCard xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" minWidth="0" minHeight="0">
<VBox fx:id="root" styleClass="doc-panel, glass" minWidth="0" minHeight="0">
    <HBox styleClass="doc-header" alignment="CENTER_LEFT" spacing="10">
        <Label fx:id="slotBadge" styleClass="slot-badge" minWidth="-Infinity"/>
        <VBox spacing="1" minWidth="0" HBox.hgrow="ALWAYS">
            <Label fx:id="fileName" styleClass="doc-name" maxWidth="Infinity"/>
            <Label fx:id="fileState" styleClass="doc-state" maxWidth="Infinity"/>
        </VBox>
        <Button fx:id="removeButton" styleClass="icon-button, danger-hover" onAction="#remove"/>
    </HBox>

    <StackPane fx:id="viewerHost" styleClass="viewer-host" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS">
        <PdfViewerPane fx:id="viewer"/>
        <DropZone fx:id="dropZone"/>
        <Label fx:id="message" styleClass="viewer-message" wrapText="true" visible="false"/>
    </StackPane>

    <!-- FlowPane: se o painel ficar estreito, os grupos de controles quebram de linha em vez de serem cortados. -->
    <FlowPane fx:id="toolbar" styleClass="doc-toolbar" hgap="16" vgap="6" alignment="CENTER_LEFT"
              rowValignment="CENTER" columnHalignment="LEFT">
        <HBox styleClass="tool-group" spacing="4" alignment="CENTER_LEFT">
            <Button fx:id="prevButton" styleClass="icon-button" onAction="#previousPage"/>
            <TextField fx:id="pageField" styleClass="page-field"/>
            <Label fx:id="pageTotal" styleClass="muted"/>
            <Button fx:id="nextButton" styleClass="icon-button" onAction="#nextPage"/>
        </HBox>
        <HBox styleClass="tool-group" spacing="4" alignment="CENTER_LEFT">
            <Button fx:id="zoomOutButton" styleClass="icon-button" onAction="#zoomOut"/>
            <Label fx:id="zoomLabel" styleClass="zoom-label"/>
            <Button fx:id="zoomInButton" styleClass="icon-button" onAction="#zoomIn"/>
            <ToggleButton fx:id="fitToggle" text="Ajustar" styleClass="chip-toggle" onAction="#toggleFit"/>
        </HBox>
    </FlowPane>
</VBox>
</GlassCard>
